{
  "name": "webapp",
  "version": "1.0.0",
  "description": "แดชบอร์ด Web Application สำหรับ MeeChain Blockchain Platform",
  "main": "server.js",
  "scripts": {
    "build": "node scripts/build-pages.mjs",
    "deploy:worker": "wrangler deploy -c wrangler.worker.toml --keep-vars",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "hardhat": "npx hardhat node",
    "deploy": "cd blockchain && npx hardhat run scripts/deploy.js --network localhost",
    "test:rpc": "bash scripts/test-rpc.sh",
    "test:prod": "bash scripts/test-production.sh",
    "test:prod:local": "bash scripts/test-production.sh https://localhost:8445 --insecure --skip-network",
    "test:browser:live": "node scripts/browser-regression.mjs",
    "infra:start": "bash scripts/start.sh",
    "infra:stop": "bash scripts/stop.sh",
    "docs": "jsdoc -c jsdoc.json",
    "docs:watch": "nodemon --watch src --watch server.js --exec \"npm run docs\""
  },
  "keywords": [
    "MeeChain",
    "Blockchain",
    "Dashboard"
  ],
  "author": "Thanawat",
  "license": "MIT",
  "dependencies": {
    "@openzeppelin/contracts": "5.0.2",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "ethers": "^6.16.0",
    "express": "^4.22.1",
    "js-yaml": "^4.1.1",
    "openai": "^6.33.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "docdash": "^2.0.2",
    "hardhat": "^2.28.0",
    "install": "^0.13.0",
    "jsdoc": "^4.0.5",
    "nodemon": "^3.1.14",
    "npm": "^11.11.0",
    "playwright": "^1.59.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
