# ============================================================
# MeeChain Platform — Environment Example
# Copy to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ── Smart Contract Addresses (Ritual Chain 13390) ───────────
VITE_TOKEN_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
VITE_NFT_CONTRACT_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
VITE_STAKING_CONTRACT_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0

# ── RPC Endpoints ───────────────────────────────────────────
# Primary RPC (Cloudflare Worker proxy → your origin node)
DRPC_RPC_URL=https://rpc.meechain.live/rpc
VITE_RPC_URL=https://rpc.meechain.live/rpc
CHAIN_ID=13390

# Fallback: direct IP (uncomment if Cloudflare is down)
# DRPC_RPC_URL=http://YOUR_SERVER_IP:8080
# VITE_RPC_URL=http://YOUR_SERVER_IP:8080

# ── Server ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Domains ─────────────────────────────────────────────────
APP_DOMAIN=app.meechain.live
RPC_DOMAIN=rpc.meechain.live

# ── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=https://app.meechain.live,https://rpc.meechain.live,http://localhost:3000

# ── OpenAI / MeeBot AI ──────────────────────────────────────
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── dRPC Access Key (optional) ──────────────────────────────
# DRPC_ACCESS_KEY=your-drpc-key-here

# ── NodeCore API (optional) ─────────────────────────────────
# NODECORE_API_KEY=your-nodecore-key

# ── NodeCloud API (optional) ────────────────────────────────
# NODECLOUD_API_KEY=your-nodecloud-key
# NODECLOUD_STATS_KEY=your-nodecloud-stats-key
